[Unit]
Description=Portfolio HTTPS health and backup validation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=portfolio-publisher
Group=portfolio-publisher
WorkingDirectory=/srv/cemyildiz-portfolio
ExecStart=/usr/bin/python3 /srv/cemyildiz-portfolio/scripts/portfolio_ops.py health --state /var/lib/portfolio-publisher/state
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-publisher
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
